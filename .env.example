# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this app is hosted (e.g., https://certisphere-eij8.onrender.com)
APP_URL="https://certisphere-eij8.onrender.com"

# --- REAL EMAIL DISPATCH OPTIONS ---

# OPTION 1: Resend (RECOMMENDED for Render Free tier - uses HTTPS port 443, never blocked)
# Get a free key at https://resend.com (100 free emails/day)
RESEND_API_KEY="re_123456789"
RESEND_FROM="CertiSphere <onboarding@resend.dev>"

# OPTION 2: Brevo API (RECOMMENDED - 300 free emails/day over HTTPS)
# Get a free API key at https://brevo.com
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER="your-email@gmail.com"

# OPTION 3: Direct SMTP (Gmail App Password - works on localhost or paid cloud instances; blocked by Render Free tier)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="CertiSphere VFSTR <your-email@gmail.com>"
